# Можно оставить пустыми: тогда используются идентификаторы официального
# Telegram Desktop (API ID 2040), и my.telegram.org не нужен.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Локально сессия пишется в файл после python scripts/login.py
TELEGRAM_SESSION_PATH=data/user.session
# На сервер можно вместо файла положить строку:
TELEGRAM_SESSION=

# Бот из @BotFather — кастинги придут в чат с этим ботом.
# Без токена находки уйдут в Избранное того же аккаунта.
BOT_TOKEN=
BOT_OWNER_ID=

PROFILE_CITY=Москва
PROFILE_GENDER=female
PROFILE_AGE=25
PROFILE_HEIGHT_CM=

SCAN_MODE=all
LOOKBACK_HOURS=36
MESSAGES_PER_CHAT=40
SCAN_INTERVAL_MINUTES=20
MAX_NOTIFY_PER_CYCLE=25
CHAT_DELAY_SECONDS=0.8

INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=набор закрыт,уже набрали,итоги кастинга
KIDS_OK=false

SQLITE_PATH=data/seen.db
NOTIFY_PEER=me
# На компьютере не задавайте PORT. Railway выставит его сам.
LOG_LEVEL=INFO
