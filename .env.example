TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=string_session_from_scripts_login

# Профиль — подставьте свои данные. Пустое значение = не фильтровать по полю.
PROFILE_CITY=Москва
PROFILE_GENDER=female
PROFILE_AGE=25
PROFILE_HEIGHT_CM=

# all = все группы/каналы из диалогов; title = только чаты с «кастинговыми» словами в названии
SCAN_MODE=all
LOOKBACK_HOURS=36
MESSAGES_PER_CHAT=40
SCAN_INTERVAL_MINUTES=20
MAX_NOTIFY_PER_CYCLE=25
CHAT_DELAY_SECONDS=0.8

# Доп. слова через запятую
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=набор закрыт,уже набрали,итоги кастинга
KIDS_OK=false

SQLITE_PATH=data/seen.db
NOTIFY_PEER=me
PORT=8080
LOG_LEVEL=INFO
