TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=string_session_from_scripts_login

# BotFather token. Leave empty to keep legacy notifications in Saved Messages.
BOT_TOKEN=
# Optional: numeric Telegram user ID allowed to control the bot.
# If empty, only the account in TELEGRAM_SESSION can control it.
BOT_OWNER_ID=

# Profile. Empty field = do not filter by the field.
PROFILE_CITY=Москва
PROFILE_GENDER=female
PROFILE_AGE=25
PROFILE_HEIGHT_CM=

# all = all subscribed groups/channels; title = only casting-related titles
SCAN_MODE=all
LOOKBACK_HOURS=36
MESSAGES_PER_CHAT=40
SCAN_INTERVAL_MINUTES=20
MAX_NOTIFY_PER_CYCLE=25
CHAT_DELAY_SECONDS=0.8

INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=набор закрыт,уже набрали,итоги кастинга
KIDS_OK=false

SQLITE_PATH=data/seen.db
NOTIFY_PEER=me
PORT=8080
LOG_LEVEL=INFO
