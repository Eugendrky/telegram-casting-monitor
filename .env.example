# Register your own application at https://my.telegram.org/apps.
# Do not use shared Telegram Desktop API keys or impersonated client metadata.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/user.session
TELEGRAM_SESSION=
BOT_TOKEN=
BOT_OWNER_ID=

# Disabled on deployment until Telegram access and selected channels are confirmed.
SCAN_ENABLED=false
PROFILE_CITY=Москва
PROFILE_GENDER=any
PROFILE_AGE=
PROFILE_HEIGHT_CM=
KIDS_OK=false

# Only explicitly selected channels/groups are eligible.
SCAN_MODE=selected
LOOKBACK_HOURS=36
MESSAGES_PER_CHAT=15
SCAN_INTERVAL_MINUTES=180
MAX_NOTIFY_PER_CYCLE=8
CHAT_DELAY_SECONDS=3

INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=набор закрыт,уже набрали,итоги кастинга

# Optional, rule-based selection works without AI.
CASTING_AI_ENABLED=false
CASTING_AI_API_KEY=
CASTING_AI_MODEL=gpt-4o-mini

SQLITE_PATH=data/seen.db
NOTIFY_PEER=me
LOG_LEVEL=INFO
