# Bot API-only mode: no Telegram user session or API ID needed.
BOT_TOKEN=
# Use /start to retrieve this number if unknown, then set BOT_OWNER_ID.
BOT_OWNER_ID=
SQLITE_PATH=/data/castings.db
LOG_LEVEL=INFO
# Enable privacy exceptions in BotFather or make the bot an admin in groups
# so it can receive regular messages. Channels require bot admin rights.
